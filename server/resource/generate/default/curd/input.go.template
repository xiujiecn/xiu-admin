@{ if eq .options.Step.HasStatus true }
// @{.varName}StatusParam 更新@{.tableComment}状态
type @{.varName}StatusParam struct {
	@{.pk.GoName} @{.pk.GoType} `json:"@{.pk.TsName}" v:"required#@{.pk.Dc}不能为空" dc:"@{.pk.Dc}"`
	Status int   `json:"status" dc:"状态"`
}

func (in *@{.varName}StatusParam) Filter(ctx context.Context) (err error) {
	if in.@{.pk.GoName} <= 0 {
		err = gerror.New("@{.pk.Dc}不能为空")
		return
	}

	if in.Status <= 0 {
		err = gerror.New("状态不能为空")
		return
	}

	if (!slices.Contains(consts.StatusSlice, in.Status)) {
		err = gerror.New("状态不正确")
		return
	}
	return
}

type @{.varName}StatusModel struct{}
