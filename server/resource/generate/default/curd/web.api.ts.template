import { requestClient } from '#/api/request';

// 获取@{.tableComment}列表
export function List(params:any) {
  return requestClient.get<any>('gen/@{.apiPrefix}/list', { params });
}
@{ if eq .options.Step.HasDel true }
// 删除/批量删除@{.tableComment}
export function Delete(params:any) {
  return requestClient.post<any>('gen/@{.apiPrefix}/delete', { ...params });
}
@{end}
@{ if eq .options.Step.HasEdit true }
// 添加/编辑@{.tableComment}
export function Edit(params:any) {
  return requestClient.post<any>('gen/@{.apiPrefix}/edit', { ...params });
}
@{end}
@{ if eq .options.Step.HasStatus true }
// 修改@{.tableComment}状态
export function Status(params:any) {
  return requestClient.post<any>('gen/@{.apiPrefix}/status', { ...params });
}
@{end}
@{ if eq .options.Step.HasSwitch true }
// 操作@{.tableComment}开关
export function Switch(params:any) {
  return requestClient.post<any>('gen/@{.apiPrefix}/switch', { ...params });
}
@{end}
@{ if or (eq .options.Step.HasView true) (eq .options.Step.HasEdit true) }
// 获取@{.tableComment}指定详情
export function View(params:any) {
  return requestClient.get<any>('gen/@{.apiPrefix}/view', { params });
}
@{end}
@{ if eq .options.Step.HasMaxSort true }
// 获取@{.tableComment}最大排序
export function MaxSort(params:any) {
  return requestClient.get<any>('gen/@{.apiPrefix}/maxSort', { params });
}
@{end}
@{ if eq .options.Step.HasExport true }
// 导出@{.tableComment}
export function Export(params:any) {
  return requestClient.post<Blob>('/gen/@{.apiPrefix}/export',  { ...params } , {
    headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
    responseType: 'blob',
  });
}

@{end}
@{ if eq .options.Step.IsTreeTable true }
// 获取@{.tableComment}关系树选项
export function TreeOption() {
  return requestClient.get<any>('gen/@{.apiPrefix}/treeOption');
}
@{end}
