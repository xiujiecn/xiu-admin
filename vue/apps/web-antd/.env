# 应用标题
VITE_APP_TITLE=XiuAdmin
VBEN_LOGO_URL=/images/logo.png
# 应用命名空间，用于缓存、store等功能的前缀，确保隔离
VITE_APP_NAMESPACE=xiu-admin-web
# 客户端ID
VITE_GLOB_CLIENT_ID=e5cd7e4891bf95d1d19206ce24a7b32e
# 对store进行加密的密钥，在将store持久化到localStorage时会使用该密钥进行加密
VITE_APP_STORE_SECURE_KEY=please-replace-me-with-your-own-key
